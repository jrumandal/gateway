# Example environment — copy to `.env` and adjust for your machine.
#   cp .env.example .env

# Service
SERVICE_NAME="api-gateway"
PORT=4200
NODE_ENV="development"

# Comma-separated list of service endpoints to stitch (defaults to the
# catalog/cart/user services on localhost:4001-4003).
# GATEWAY_SERVICES="http://localhost:4001/graphql,http://localhost:4002/graphql,http://localhost:4003/graphql"
